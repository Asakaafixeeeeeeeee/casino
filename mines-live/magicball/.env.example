# Magic Ball Live — copy to .env (or set these in the host) ----------------------------------------------------
# The port the server listens on
PORT=3000
# Show the small ROUND / SERVER TIME / STATE box on the page (1) or not (0). Leave 0 in production.
DEV_INDICATOR=1
# A secret for the admin dashboard: open /admin.html?token=<this>. Leave empty and the dashboard is disabled.
ADMIN_TOKEN=
# PostgreSQL. Leave empty to keep everything in memory (rounds, bets and demo wallets reset on restart).
DATABASE_URL=
# Redis, for running more than one server instance behind one game (see server/socket.js). Leave empty for one.
REDIS_URL=
